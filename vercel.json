{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/absences-monthly",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/absences-month-close",
      "schedule": "0 17 28-31 * *"
    },
    {
      "path": "/api/cron/reviews-hub",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/wpe-logs",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/bonus-summary",
      "schedule": "0 9 1 * *"
    }
  ]
}
